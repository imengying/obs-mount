# 复制到 /etc/obs/obs-mount.yaml 并 chmod 600，填入真实值。
# 用 IAM 子账号 + 仅该桶权限，不要用主账号 AK/SK。
mountpoint: /mnt/obs
bucket: your-bucket-name

# endpoint 两种写法，程序按 host 自动选择寻址方式：
#   桶虚拟主机式 https://<bucket>.obs.<region>.myhuaweicloud.com
#   服务级       https://obs.<region>.myhuaweicloud.com （自动走 /<bucket>/<key>）
# IP 或自定义域名同样走路径式。
endpoint: https://your-bucket-name.obs.cn-north-4.myhuaweicloud.com

ak: YOUR_ACCESS_KEY_HERE
sk: YOUR_SECRET_KEY_HERE

# 默认 25 MB 起用分段上传，每片 10 MB（与华为 obsfs 一致）。一般不用改。
# multipart_threshold: 26214400
# multipart_part_size: 10485760
