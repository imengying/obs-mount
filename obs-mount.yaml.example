# 复制一份，填好 AK/SK、桶和 endpoint，然后 chmod 600 再使用。
# 建议用 IAM 子账号，只授予该桶的权限，不要用主账号 AK/SK。
mountpoint: /mnt/obs
bucket: your-bucket-name

# 服务级端点即可，程序会自动补成 <bucket>.obs.<region>.myhuaweicloud.com：
#   https://obs.cn-north-4.myhuaweicloud.com
# 也可以直接写带桶的虚拟主机式地址。IP 端点（自建网关、MinIO 等）自动用路径式。
endpoint: https://obs.cn-north-4.myhuaweicloud.com

ak: YOUR_ACCESS_KEY_HERE
sk: YOUR_SECRET_KEY_HERE

# 默认 25 MB 起用分段上传，每片 10 MB（与华为 obsfs 一致）。一般不用改。
# multipart_threshold: 26214400
# multipart_part_size: 10485760

# 分段大小允许 100 KiB～5 GiB；单次 PUT 超过 5 GiB 会强制分段。
# 工作线程直接从暂存文件读取各段，不把整个分段读入内存。
# upload_concurrency: 4          # 1～32

# 暂存始终使用系统 TMPDIR（默认 /tmp）。低于保留空间时拒绝继续扩展文件。
# min_free_space: 67108864       # 64 MiB；设为 0 关闭预留检查
# metadata_cache_entries: 10000  # 本地仍有暂存文件的元数据不参与淘汰

# 每次尝试的总超时；连接建立超时为 30 秒。
# request_timeout_secs: 120      # 元数据等普通请求
# transfer_timeout_secs: 3600    # 内容传输、复制、合并分段
