[Unit]
Description=Mount a Huawei Cloud OBS bucket as a local directory (FUSE, native OBS REST signing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/etc/obs/obs-mount --config /etc/obs/obs-mount.yaml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
